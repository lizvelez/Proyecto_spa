using System;
using System.Collections.Generic;
using System.Threading;

namespace SpaApp
{
    class Program
    {
        static List<Cita> citas = new List<Cita>();
        static object bloqueo = new object();

        static void Main(string[] args)
        {
            int opcion;

            do
            {
                Console.Clear();
                Console.WriteLine("===== SISTEMA SPA =====");
                Console.WriteLine("1. Registrar cita");
                Console.WriteLine("2. Ver citas");
                Console.WriteLine("3. Cancelar cita");
                Console.WriteLine("4. Simular concurrencia");
                Console.WriteLine("5. Salir");
                Console.Write("Seleccione una opción: ");
                opcion = int.Parse(Console.ReadLine());

                switch (opcion)
                {
                    case 1:
                        RegistrarCitaManual();
                        break;
                    case 2:
                        MostrarCitas();
                        break;
                    case 3:
                        CancelarCita();
                        break;
                    case 4:
                        SimularConcurrencia();
                        break;
                }

                Console.WriteLine("\nPresione una tecla para continuar...");
                Console.ReadKey();

            } while (opcion != 5);
        }
        static void RegistrarCitaManual()
        {
            Console.Clear();

            Cita nueva = new Cita();

            Console.Write("Nombre del cliente: ");
            nueva.NombreCliente = Console.ReadLine();

            Console.Write("Servicio: ");
            nueva.Servicio = Console.ReadLine();

            Console.Write("Fecha: ");
            nueva.Fecha = Console.ReadLine();

            Console.Write("Hora: ");
            nueva.Hora = Console.ReadLine();

            lock (bloqueo)
            {
                foreach (var c in citas)
                {
                    if (c.Fecha == nueva.Fecha && c.Hora == nueva.Hora)
                    {
                        Console.WriteLine("⚠ Ese horario ya está ocupado.");
                        return;
                    }
                }

                citas.Add(nueva);
                Console.WriteLine("✅ Cita registrada correctamente.");
            }
        }
        static void MostrarCitas()
        {
            Console.Clear();

            if (citas.Count == 0)
            {
                Console.WriteLine("No hay citas registradas.");
                return;
            }

            int i = 1;
            foreach (var c in citas)
            {
                Console.WriteLine($"Cita #{i}");
                Console.WriteLine($"Cliente: {c.NombreCliente}");
                Console.WriteLine($"Servicio: {c.Servicio}");
                Console.WriteLine($"Fecha: {c.Fecha}");
                Console.WriteLine($"Hora: {c.Hora}");
                Console.WriteLine("-----------------------");
                i++;
            }
        }
        static void CancelarCita()
        {
            Console.Clear();

            if (citas.Count == 0)
            {
                Console.WriteLine("No hay citas para cancelar.");
                return;
            }

            MostrarCitas();
            Console.Write("\nIngrese el número de la cita a cancelar: ");
            int num = int.Parse(Console.ReadLine());

            lock (bloqueo)
            {
                if (num > 0 && num <= citas.Count)
                {
                    citas.RemoveAt(num - 1);
                    Console.WriteLine("Cita cancelada.");
                }
                else
                {
                    Console.WriteLine("Número inválido.");
                }
            }
        }
        static void SimularConcurrencia()
        {
            Console.Clear();
            Console.WriteLine("Simulando múltiples usuarios...\n");

            Thread t1 = new Thread(() => SimularCita("Ana", "10:00"));
            Thread t2 = new Thread(() => SimularCita("Juan", "10:00"));
            Thread t3 = new Thread(() => SimularCita("Luis", "11:00"));

            t1.Start();
            t2.Start();
            t3.Start();

            t1.Join();
            t2.Join();
            t3.Join();

            Console.WriteLine("\nSimulación finalizada.");
        }
        static void SimularCita(string cliente, string hora)
        {
            Thread.Sleep(100); // simula retraso

            Cita nueva = new Cita
            {
                NombreCliente = cliente,
                Servicio = "Masaje",
                Fecha = "01/04/2026",
                Hora = hora
            };

            lock (bloqueo)
            {
                foreach (var c in citas)
                {
                    if (c.Fecha == nueva.Fecha && c.Hora == nueva.Hora)
                    {
                        Console.WriteLine($"Hilo {Thread.CurrentThread.ManagedThreadId}: {cliente} intentó {hora} (rechazado)");
                        return;
                    }
                }

                citas.Add(nueva);
                Console.WriteLine($"Hilo {Thread.CurrentThread.ManagedThreadId}: {cliente} registró {hora}");
            }
        }
    }

    class Cita
    {
        public string NombreCliente { get; set; }
        public string Servicio { get; set; }
        public string Fecha { get; set; }
        public string Hora { get; set; }
    }
}
